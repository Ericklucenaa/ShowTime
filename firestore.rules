rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone authenticated can read non-private profiles
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Custom lists: owner only
    match /custom_lists/{listId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }

    // Watch episodes: owner can write; others can read (for public profiles)
    match /watch_episodes/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Followed shows: same pattern
    match /followed_shows/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Followed users
    match /followed_users/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.followerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
    }

    // Comments and reactions: authenticated read/write
    match /comments/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /reactions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /live_chat/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
